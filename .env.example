# ═══════════════════════════════════════════════════════════════
# SecureBank Microservices — Environment Variables Template
# Copy this file to .env and fill in real values
# ═══════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────
DB_ROOT_PASSWORD=your_mysql_root_password
DB_USERNAME=root
DB_PASSWORD=your_mysql_root_password

# ── JWT ───────────────────────────────────────────────────────
# Minimum 32 characters
# RS256 key pair — securebank-api is the ONLY service that gets
# JWT_PRIVATE_KEY (it's the only one that mints tokens); every service
# gets JWT_PUBLIC_KEY (verify-only). Generate a real pair with:
#   openssl genrsa -out private.pem 2048
#   openssl pkcs8 -topk8 -inform PEM -in private.pem -out private_pkcs8.pem -nocrypt
#   openssl rsa -in private.pem -pubout -out public.pem
#   base64 -w0 private_pkcs8.pem   # -> JWT_PRIVATE_KEY
#   base64 -w0 public.pem          # -> JWT_PUBLIC_KEY
# Treat JWT_PRIVATE_KEY like any other production secret — if it leaks,
# rotate both keys (this invalidates every outstanding access token).
JWT_PRIVATE_KEY=change-me-generate-a-real-rsa-keypair-see-comment-above
JWT_PUBLIC_KEY=change-me-generate-a-real-rsa-keypair-see-comment-above
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# ── Card data encryption (C5 fix) ─────────────────────────────
# AES-256 key (base64, 32 bytes) used to encrypt card numbers at rest.
# Generate a real one with: openssl rand -base64 32
# Losing/rotating this without a re-encryption migration makes existing
# card numbers unreadable — store it somewhere durable (secrets manager),
# not just in this file.
CARD_ENCRYPTION_KEY=change-me-to-a-real-base64-32-byte-key

# ── CVV derivation (Follow-up #5, Option A) ───────────────────
# HMAC key (base64, 32 bytes) used to deterministically derive CVVs
# from PAN + expiry, so a real CVV can be shown to the cardholder or
# verified against a submission without ever being stored.
# MUST be a DIFFERENT value from CARD_ENCRYPTION_KEY — compromising one
# shouldn't compromise the other. Generate with: openssl rand -base64 32
CVV_DERIVATION_KEY=change-me-to-a-different-real-base64-32-byte-key

# ── CORS (M4 fix) ──────────────────────────────────────────────
# Your real deployed frontend origin(s), comma-separated, no wildcard.
# Localhost dev URLs still work without this being set (see CorsConfig's
# default) — this is only required in application-prod.properties.
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.example.com

# ── Mail (Gmail) ──────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# ── Kafka ─────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ── Eureka ────────────────────────────────────────────────────
EUREKA_URL=http://eureka-server:8761/eureka/

# ── File Upload ───────────────────────────────────────────────
FILE_UPLOAD_PATH=/app/uploads

# ── AI Service ────────────────────────────────────────────────
# Free key at: openrouter.ai
AI_API_KEY=sk-or-v1-your-openrouter-key
AI_BASE_URL=https://openrouter.ai/api
AI_MODEL=google/gemini-2.5-flash:free

# ── Spring Profiles ───────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod